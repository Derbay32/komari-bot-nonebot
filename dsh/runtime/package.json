{
  "name": "@komari-bot/dsh-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "komari-bot restricted DSH bridge plugin and process host",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./business": "./dist/business.js",
    "./chat-preset": "./dist/chat-preset.js",
    "./fixture": "./dist/fixture.js",
    "./host": "./dist/host.js",
    "./main": "./dist/main.js",
    "./package.json": "./package.json",
    "./race-fixture": "./dist/race-fixture.js",
    "./protocol": "./dist/protocol.js",
    "./test-main": "./dist/test-main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.test.json",
    "check": "tsc -p tsconfig.build.json && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test dist-test/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/cordis-plugin-include": "~1.0.10",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2"
  }
}
