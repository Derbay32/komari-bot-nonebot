HOST=0.0.0.0
PORT=8080
DRIVER=~fastapi
FASTAPI_DOCS_URL=/api/docs
FASTAPI_OPENAPI_URL=/api/openapi.json
FASTAPI_REDOC_URL=
FASTAPI_INCLUDE_ADAPTER_SCHEMA=false

# 用户数据插件配置
USER_DATA_DB_PATH=user_data.db
USER_DATA_DB_POOL_SIZE=5
USER_DATA_DATA_RETENTION_DAYS=30

# 命令格式
COMMAND_START=["。", "."]
COMMAND_SEP=[" "]

SUPERUSERS=[]

# PostgreSQL 数据库配置
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=komari_bot
PG_USER=komari_bot
PG_PASSWORD=change_me
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=5
PG_POOL_PROCESS_BUDGET=20

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# huggingface用的，不知道有啥用，但不写它就会写日志使我心情减8
TOKENIZERS_PARALLELISM=false

# sentry 配置，不用可以不写，要用记得去掉注释
# SENTRY_DSN=
