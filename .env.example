HOST=0.0.0.0
PORT=8080
DRIVER=~fastapi
FASTAPI_DOCS_URL=/api/docs
FASTAPI_OPENAPI_URL=/api/openapi.json
FASTAPI_REDOC_URL=
FASTAPI_INCLUDE_ADAPTER_SCHEMA=false

# 管理 API 启动配置：仅从 dotenv / 进程环境变量读取，全部修改均需重启。
# 迁移 0034 删除旧管理配置表；升级前必须在私有环境文件中配置凭据。
KOMARI_MANAGEMENT_API_ENABLED=false
KOMARI_MANAGEMENT_API_CREDENTIALS=[]
KOMARI_MANAGEMENT_API_ALLOWED_ORIGINS=[]
# 凭据使用 JSON 数组。先生成随机 Token，再替换下例占位符并启用管理 API。
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
# KOMARI_MANAGEMENT_API_CREDENTIALS='[{"credential_id":"dashboard","token":"<random-token>","permissions":["*"],"revoked_at":null}]'
# 浏览器跨域访问时填写前端 Origin，不包含 URL 路径。
# KOMARI_MANAGEMENT_API_ALLOWED_ORIGINS=["https://admin.example.com"]
KOMARI_MANAGEMENT_ANNOUNCE_STATUS_PAGE_URL=https://your.status.page/url/here
KOMARI_MANAGEMENT_ANNOUNCE_MAX_GROUP_COUNT=20
KOMARI_MANAGEMENT_ANNOUNCE_SEND_INTERVAL_SECONDS=1.0
KOMARI_MANAGEMENT_ANNOUNCE_REQUEST_COOLDOWN_SECONDS=30.0

# QQ 官方群 @ 接入（可选）。留空或使用 [] 时仅启动 OneBot/fastapi。
# 启用 QQ 时必须使用同时具备 HTTP client、ASGI server 的 driver；
# use_websocket=true 的账号还要求 WebSocket client。启动代码会把 Intent
# 收敛为仅 c2c_group_at_messages=true，修改账号或可信身份后必须重启。
# QQ_IS_SANDBOX=false
# QQ_BOTS=[{"id":"your-app-id","token":"your-token","secret":"your-secret","use_websocket":false}]
# 每个 QQ_BOTS.id 都应配置独立的正整数可信官 Bot QQ；缺失或非法值仅关闭该应用的首次绑定取证。
# QQ_OFFICIAL_BOT_QQ_BY_APP={"your-app-id":"123456789"}

# 命令格式
COMMAND_START=["。", "."]
COMMAND_SEP=[" "]

SUPERUSERS=[]

# nonebot-plugin-orm 数据库连接（SQLAlchemy URL 形式，v2.0.0 唯一权威连接来源）
# 旧 PG_HOST/PG_USER 等自研连接池配置已随 v2.0.0 下线，不再读取。
# 迁移由容器 prestart 自动执行 upgrade head；启动时还会校验数据库与迁移链一致。
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://komari_bot:change_me@localhost:5432/komari_bot

# 向量列维度（仅全新部署首次迁移建表时读取，默认 512）。
# 必须与下方 embedding_dimension 保持一致；既有部署走 stamp 不执行 DDL，无需设置。
# EMBEDDING_DIMENSION=512
# 启动时校验数据库与迁移链一致性（插件默认 true）。
# 注意：不要关闭——关闭后插件会在启动时把模型结构同步进数据库（可能删除未建模的旧表）。
ALEMBIC_STARTUP_CHECK=true

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# huggingface用的，不知道有啥用，但不写它就会写日志使我心情减8
TOKENIZERS_PARALLELISM=false

# sentry 配置，不用可以不写，要用记得去掉注释
# SENTRY_DSN=
